{
  "name": "dsh-qizhoucnc-cam",
  "version": "1.2.1",
  "description": "CNC program (NC/CNC/G-code) toolpath recognition, 3D display and a large editing view with quote-to-composer, for DeepSeek Harness (DSH). Made by Chengdu Qizhou Machinery Technology Co., Ltd., for research and study only.",
  "type": "module",
  "license": "MIT",
  "author": "Chengdu Qizhou Machinery Technology Co., Ltd.",
  "keywords": ["dsh", "deepseek-harness", "cnc", "gcode", "nc", "toolpath", "cam", "数控", "刀路"],
  "repository": {
    "type": "git",
    "url": "https://github.com/DarbeChan/dsh-qizhoucnc-cam.git"
  },
  "bugs": {
    "url": "https://github.com/DarbeChan/dsh-qizhoucnc-cam/issues",
    "email": "651712988@qq.com"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cam_script.py",
    "toolpath_render.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
